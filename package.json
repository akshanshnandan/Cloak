{
  "name": "cloak-personal-internet",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "An open-source, local AI layer that personalizes real websites.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "start": "tsx src/start.ts",
    "dashboard": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:journeys": "tsx tests/journeys.ts",
    "setup": "playwright install chromium",
    "warmup": "tsx src/warmup.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "express": "^5.1.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
